# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Editor / OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db

# This tool's own output - exported history and logs are personal
# browsing data and must never be committed.
output/*
!output/.gitkeep
